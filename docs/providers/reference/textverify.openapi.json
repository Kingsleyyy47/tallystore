    "/api/v2/tn101/get-services": {
      "get": {
        "tags": [
          "USA-Server-1"
        ],
        "summary": "Service List",
        "description": "Returns a list of active services grouped under 'United States'.",
        "operationId": "getServicesByCountry",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Services"
                    },
                    "data": {
                      "properties": {
                        "temporary": {
                          "properties": {
                            "United States": {
                              "type": "array",
                              "items": {
                                "properties": {
                                  "service": {
                                    "type": "string",
                                    "example": "Zoosk"
                                  },
                                  "price": {
                                    "type": "number",
                                    "format": "float",
                                    "example": 0.4
                                  },
                                  "has_premium": {
                                    "type": "string",
                                    "example": "1"
                                  }
                                },
                                "type": "object"
                              }
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v2/tn101/request-number": {
      "post": {
        "tags": [
          "USA-Server-1"
        ],
        "summary": "Request a temporary number",
        "description": "Authenticated users can request a temporary number for a specific service.",
        "operationId": "requestTemporaryNumber",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "service_key"
                ],
                "properties": {
                  "service_key": {
                    "type": "string",
                    "example": "8jb222"
                  },
                  "request_premium": {
                    "type": "number",
                    "format": "float",
                    "example": 20,
                    "nullable": true
                  },
                  "state": {
                    "type": "string",
                    "example": "AK",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "summery": {
                      "type": "string",
                      "example": "Requested"
                    },
                    "data": {
                      "properties": {
                        "order_id": {
                          "type": "integer",
                          "example": 356555
                        },
                        "number": {
                          "type": "string",
                          "example": "+12102511186"
                        },
                        "service": {
                          "type": "string",
                          "example": "Youtube"
                        },
                        "status": {
                          "type": "string",
                          "example": "Reserved"
                        },
                        "state": {
                          "type": "string",
                          "example": ""
                        },
                        "markup": {
                          "type": "number",
                          "example": 10
                        },
                        "price": {
                          "type": "number",
                          "format": "float",
                          "example": 0.5
                        },
                        "till_expiration": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "summery": {
                      "type": "string",
                      "example": "Error"
                    },
                    "data": {
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v2/tn101/reuse-number": {
      "post": {
        "tags": [
          "USA-Server-1"
        ],
        "summary": "Reuse a previously purchased temporary number",
        "description": "Authenticated users can reuse a previously purchased number from a successful order. Reuse pricing is based on configured percentage and current balance is checked.",
        "operationId": "reUseTemporaryNumber",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "order_id"
                ],
                "properties": {
                  "order_id": {
                    "description": "Order ID of the previous successful number order",
                    "type": "integer",
                    "example": 345
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Temporary number successfully reused",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Awaiting"
                    },
                    "data": {
                      "properties": {
                        "order_id": {
                          "type": "integer",
                          "example": 345
                        },
                        "number": {
                          "type": "string",
                          "example": "+15551234567"
                        },
                        "service": {
                          "type": "string",
                          "example": "Phone Verification"
                        },
                        "status": {
                          "type": "string",
                          "example": "Awaiting"
                        },
                        "state": {
                          "type": "string",
                          "example": "California"
                        },
                        "price": {
                          "type": "number",
                          "example": 0.99
                        },
                        "reuse": {
                          "type": "boolean",
                          "example": true
                        },
                        "till_expiration": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2025-07-05T14:35:00Z"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Error"
                    },
                    "data": {
                      "type": "object",
                      "example": {
                        "order_id": [
                          "The selected order_id is invalid."
                        ]
                      }
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Not allowed or insufficient balance",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "You have no enough balance"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v2/tn101/get-number-details": {
      "get": {
