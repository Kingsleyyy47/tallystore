    "/api/v2/tn101/reject-number": {
      "post": {
        "tags": [
          "USA-Server-1"
        ],
        "summary": "Reject a temporary number",
        "description": "Authenticated users can reject an active number (not yet successful). Balance will be reversed if rejection is accepted by the provider.",
        "operationId": "rejectTemporaryNumber",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "order_id"
                ],
                "properties": {
                  "order_id": {
                    "description": "ID of the order to reject",
                    "type": "integer",
                    "example": 789
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Number rejected and balance reversed"
          },
          "422": {
            "description": "Validation failed or already rejected"
          },
          "400": {
            "description": "Invalid status or not allowed"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v2/tn101/us-states": {
