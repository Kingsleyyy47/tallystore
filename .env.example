# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Ercas Pay Configuration
# Get your API keys from: https://dashboard.ercaspay.com/settings/api-keys

# Server-only API keys
# Do not prefix payment-provider secrets with VITE_. VITE_ variables are exposed
# to the browser build. Set these in Supabase Edge Function secrets / Vercel
# server environment only:
#   ERCAS_SECRET_KEY=ECRS-TEST-or-LIVE-your_secret_key_here
#   ERCASPAY_MERCHANT_ID=your_expected_merchant_id
#   ERCASPAY_ENVIRONMENT=test_or_live
#   TALLYSTORE_SITE_ORIGIN=https://tallystore.org
# Set a separate HTTPS origin for staging; Ercas redirects always use this
# server-controlled origin rather than a browser-supplied URL or Origin header.
# Owner-only staff and wallet adjustment functions also require this server-side
# value, set before deploying those functions (never prefix with VITE_):
#   TALLYSTORE_OWNER_USER_ID=reviewed_auth_users_uuid

# Environment Mode (test or live)
# Keep provider mode server-side for payment verification:
#   ERCAS_MODE=test

# API Base URL (staging for test, live for production)
#   ERCAS_BASE_URL=https://api-staging.ercaspay.com/api/v1
#   ERCAS_BASE_URL=https://api.ercaspay.com/api/v1

# PocketFi Configuration (second wallet top-up gateway, alongside Ercas Pay)
# PocketFi uses PERMANENT VIRTUAL ACCOUNTS — users bank-transfer into a dedicated
# account number instead of going through a hosted checkout page.
# These are NOT used client-side — set them as Supabase Edge Function secrets
# (Supabase dashboard > Edge Functions > create-pocketfi-topup > Secrets), not here:
#   POCKETFI_PUBLIC_KEY=your_pocketfi_public_key   (the Sanctum-style "id|token" credential —
#                                                    this is the actual bearer token for API calls,
#                                                    despite being called "Public" in PocketFi's dashboard)
#   POCKETFI_SECRET_KEY=your_pocketfi_secret_key   (a plain hex string — used ONLY to verify
#                                                    inbound webhook signatures, NOT for API auth)
#   POCKETFI_BUSINESS_ID=your_pocketfi_business_id
#   POCKETFI_BASE_URL=https://api.pocketfi.ng/api/v1   (confirm against PocketFi's current docs)
# Also set on Vercel (for api/webhook-pocketfi.ts, shared with the Ercas webhook):
#   VITE_SUPABASE_URL=...
#   SUPABASE_SERVICE_ROLE_KEY=...

# MuaBanVia Configuration (live auto-fulfillment when pre-stocked accounts run out)
# NOT used client-side — set as Supabase Edge Function secrets, shared by both
# muabanvia-fulfill and process-purchase functions
# (Supabase dashboard > Edge Functions > Secrets):
#   MUABANVIA_API_KEY=your_muabanvia_api_key
#   MUABANVIA_BASE_URL=https://api.muabanvia.com/api/v1   (confirm against MuaBanVia's current docs)
# Per-product auto-fulfillment is toggled in Admin > Edit Product Template
# (muabanvia_product_id + "Enable auto-fulfillment" checkbox) — no extra Vercel config needed.

# Incident pause flags. Keep unset or false in production until the matching
# route has staging/provider/deployed smoke evidence.
# BILLS_ENABLED=false
# BITREFILL_ENABLED=false
# WITHDRAWALS_ENABLED=false
# REFERRAL_WITHDRAWALS_ENABLED=false
# CRYPTO_TOPUP_ENABLED=false
# SMM_ORDERS_ENABLED=false
# SMS_OTP_ENABLED=false
# TELEGRAM_ORDERS_ENABLED=false
# LIVE_ACCOUNT_FULFILLMENT_ENABLED=false
# AUTO_RESTOCK_ENABLED=false
# MANUAL_RESTOCK_ENABLED=false

# Example:
# VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Instructions:
# 1. Go to https://supabase.com and create a new project
# 2. Go to Settings > API in your Supabase dashboard
# 3. Copy your project URL and anon/public key
# 4. Go to https://dashboard.ercaspay.com and get your API keys
# 5. Replace the values above with your actual credentials
# 6. Rename this file to .env.local (remove .example)

# Provider integrations (Supabase server secrets ONLY; never add VITE_).
# Separate Daisy domains are separate supplier accounts and keys.
# DAISYSMS_IO_API_KEY=
# DAISYSMS_COM_API_KEY=
# DAISYSMS_API_KEY=            # legacy alias, .io by default
# GETATEXT_API_KEY=
# DAISYSIM_API_KEY=          # optional legacy direct API only; store DaisySim uses SMSBUS_API_KEY below
# HEROSMS_API_KEY=            # SMSACTIVATE_API_KEY remains an alias
# HEROSMS_CURRENCY=USD        # only for a confirmed USD API account
# TEXTVERIFY_API_KEY=
# SMSBUS_API_KEY=            # DaisySim / SMSBus account, shared OTP and rental connection
# SMS_RENTALS_ENABLED=false
# PVACODES_API_KEY=           # reserved; private endpoint documentation required
# LORDOFPANELS_API_KEY=       # SMM_PANEL_API_KEY remains an alias
# BULKFOLLOWS_API_KEY=
# BITREFILL_API_KEY=          # existing Personal API bearer-token flow
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# FRAGMENTAPI_API_KEY=        # ISTAR_API_KEY remains an alias
# FRAGMENTAPI_BASE_URL=https://v1.fragmentapi.app/api/v1/partner
# KORAPAY_SECRET_KEY=
# KORAPAY_ENABLED=false
# PROVIDER_CATALOG_SYNC_SECRET= # random server-only token, also stored in Vault by configure_provider_catalog_auto_sync
# Kora webhook: /functions/v1/korapay-webhook (HMAC of payload.data).
# Existing purchase pause flags above still apply after keys are added.
